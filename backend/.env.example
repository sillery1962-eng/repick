# Supabase 프로젝트 주소 (Project URL)
SUPABASE_URL=

# Supabase secret 키 — 백엔드 전용, 절대 프론트엔드·Git·채팅에 넣지 않기
SUPABASE_SECRET_KEY=

# 접속을 허락할 프론트엔드 주소 (Vite 기본 주소)
FRONTEND_ORIGIN=http://localhost:5173

# OpenAI API 키 (sk-proj-로 시작) — 챗봇이 CSV에 없는 질문에 답할 때만 씀. 백엔드 전용, Git·채팅에 올리지 않기
# 비워 두면 ChatGPT 없이 지금처럼 CSV로만 답함
OPENAI_API_KEY=
# (선택) 쓸 모델 이름. 비우면 gpt-4o-mini
OPENAI_MODEL=
