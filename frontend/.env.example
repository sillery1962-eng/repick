# 이 파일을 복사해서 frontend/.env 를 만들고 값을 채우세요. (.env는 Git에 올라가지 않습니다)
# 값을 바꾼 뒤에는 개발 서버(npm run dev)를 껐다 켜야 반영됩니다.
# VITE_ 로 시작하는 값은 브라우저에 그대로 보이므로 비밀 키(Supabase secret 등)는 절대 넣지 않습니다.

# 카카오맵 JavaScript 키 (수거함 찾기). 비워 두면 서울 구 경계 기본 지도로 표시됩니다.
VITE_KAKAO_JS_KEY=

# 수거함 제보를 받을 연락처 (선택, 제보 창에 표시)
VITE_REPORT_CONTACT=

# Supabase 회원 기능 (Supabase → Project Settings → API Keys)
# URL과 Publishable key(sb_publishable_...)만 넣습니다. Secret key는 절대 넣지 않습니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 백엔드(FastAPI) 주소 (예: http://localhost:8000). 비워 두면 이벤트 퀴즈가 예시 3문제로 동작합니다 (시안 모드).
VITE_API_URL=
